{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "checkJs": true,
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "extension/**/*.js",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "types/**/*.d.ts"
  ]
}
