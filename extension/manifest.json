{
  "manifest_version": 3,
  "name": "Crossfeed Chat Wake",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "description": "Start fresh ChatGPT chats for saved Crossfeed workers.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs",
    "tabGroups",
    "debugger"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
